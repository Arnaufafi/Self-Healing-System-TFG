' Figura 4.10 - Diagrama de sequencia: integracio en CI/CD
' Render: https://www.plantuml.com/plantuml  o  SmartDraw (Insert > UML Sequence Diagram > import)
@startuml
actor "Desenvolupador" as Dev
participant "Canonada CI/CD" as CI
participant "Sistema d'autocuració" as Sys
participant "Sandbox (Docker)" as Box
participant "Proveïdor d'LLM" as LLM
participant "Plataforma de codi" as Plat

Dev -> CI : puja un canvi
activate CI
CI -> CI : executa la bateria de proves
note right of CI : una prova es posa en vermell
CI -> Sys : dispara el guariment\n(test que falla)
deactivate CI

activate Sys
note over Sys, LLM : execució desatesa, en segon pla
Sys -> Box : reprodueix la fallada
activate Box
Box --> Sys : confirmada
deactivate Box
loop fins a resoldre o esgotar el pressupost
  Sys -> LLM : demana la correcció (Corrector)
  activate LLM
  LLM --> Sys : pedaç
  deactivate LLM
  Sys -> Box : valida (reproducció + no-regressió)
  activate Box
  Box --> Sys : veredicte
  deactivate Box
end
Sys -> Plat : obre la Pull Request\n(correcció + test + informe)
deactivate Sys

activate Plat
Plat -> Dev : notifica la proposta
deactivate Plat

Dev -> Plat : revisa i aprova o rebutja
@enduml
